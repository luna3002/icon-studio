# 이 파일을 복사해서 .env 로 만들고 값을 채우세요. (.env 는 .gitignore 로 커밋되지 않음)
#   cp .env.example .env

# Google AI Studio 에서 발급: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=여기에_키를_붙여넣기

# 무료 티어 텍스트 모델. 비워두면 gemini-2.5-flash 사용.
# (대안 예시) gemini-2.5-flash-lite  ← 더 높은 무료 한도
GEMINI_MODEL=gemini-2.5-flash

# 로컬 dev 서버 포트
PORT=5173
